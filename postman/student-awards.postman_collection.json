      "name": "Authentication",
      "item": [
        {
          "name": "Login as student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.expect(pm.response.code).to.eql(200); });",
                  "const json = pm.response.json();",
                  "pm.test(\"Student login returns a token\", function () { pm.expect(json.access_token).to.be.a(\"string\"); });",
                  "if (json.access_token) { pm.collectionVariables.set('studentToken', json.access_token); }",
                  "pm.test(\"Response contains a key field\", function () { const keys = Object.keys(json || {}); pm.expect(keys.length > 0).to.eql(true); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"bob\",\n  \"password\": \"bobpass\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "response": []
