              "mode": "raw",
              "raw": "{\n  \"activity\": \"Park cleanup\",\n  \"date\": \"2026-11-10\",\n  \"hours\": 3.5,\n  \"description\": \"Helped with the local park cleanup.\",\n  \"proof\": \"receipt-park\"\n}"
            },
