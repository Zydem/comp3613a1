    {
      "name": "Student workflow",
      "item": [
        {
          "name": "Get rewards catalog",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.expect(pm.response.code).to.eql(200); });",
                  "const json = pm.response.json();",
                  "const cheapReward = Array.isArray(json) ? json.find(item => item.eligible && (item.point_cost || item.pointscost || 0) <= 90) : null;",
                  "if (cheapReward) { const rewardId = cheapReward.reward_id ?? cheapReward.rewardid; pm.collectionVariables.set('rewardId', String(rewardId)); }",
                  "pm.test(\"Response contains rewards and key field\", function () { pm.expect(Array.isArray(json) || Object.keys(json || {}).length > 0).to.eql(true); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/rewards",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rewards"]
            }
          },
          "response": []
        },
        {
          "name": "Create claim",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () { pm.expect(pm.response.code).to.eql(201); });",
                  "const json = pm.response.json();",
                  "if (json.claim && (json.claim.claimid || json.claim.id)) { pm.collectionVariables.set('claimId', String(json.claim.claimid || json.claim.id)); }",
                  "pm.test(\"Claim payload contains a key field\", function () { const keys = Object.keys(json || {}); pm.expect(keys.length > 0).to.eql(true); });"
                ],
                "type": "text/javascript"
              }
            }
